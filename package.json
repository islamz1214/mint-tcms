{
  "name": "mint",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "e2e",
    "test-ui"
  ],
  "description": "Test management application monorepo",
  "scripts": {
    "dev:api": "npm run start:dev --workspace api",
    "dev:web": "npm run dev --workspace web",
    "build:api": "npm run build --workspace api",
    "build:web": "npm run build --workspace web",
    "test:api": "npm run test --workspace api",
    "test:e2e:api": "npm run test:e2e --workspace api",
    "test:smoke": "npm run test:smoke --workspace e2e",
    "test:smoke:chromium": "npm run test:smoke:chromium --workspace e2e",
    "test:smoke:cross-browser": "npm run test:smoke:cross-browser --workspace e2e",
    "test:smoke:full": "npm run test:smoke:full --workspace e2e",
    "test:e2e": "npm run test:features --workspace e2e",
    "test:e2e:chromium": "npm run test:features:chromium --workspace e2e",
    "test:e2e:cross-browser": "npm run test:features:cross-browser --workspace e2e",
    "test:e2e:full": "npm run test:features:full --workspace e2e",
    "test:a11y": "npm run test:a11y --workspace e2e",
    "test:a11y:chromium": "npm run test:a11y:chromium --workspace e2e",
    "test:a11y:cross-browser": "npm run test:a11y:cross-browser --workspace e2e",
    "test:a11y:full": "npm run test:a11y:full --workspace e2e",
    "test:e2e:all": "npm run test --workspace e2e",
    "test:e2e:all:chromium": "npm run test:chromium --workspace e2e",
    "test:e2e:all:cross-browser": "npm run test:cross-browser --workspace e2e",
    "test:e2e:all:full": "npm run test:full --workspace e2e",
    "test:e2e:ui": "npm run test:ui --workspace e2e",
    "test:ui:test-case": "npm run test --workspace test-ui",
    "test:ui:test-case:headed": "npm run test:headed --workspace test-ui",
    "lint": "npm run lint --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "seed": "npm --prefix api run seed"
  }
}
